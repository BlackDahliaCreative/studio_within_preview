{
    // Your global "Run on Save" rule runs `tsc ${file}` on every .ts save. In this
    // project that writes a CommonJS .js copy next to the .ts file, which Vite then
    // loads instead and the site crashes. Vite compiles TypeScript itself, so it's
    // switched off here (other projects keep it).
    "emeraldwalk.runonsave": {
        "commands": []
    },
    "triggerTaskOnSave.on": false
}
